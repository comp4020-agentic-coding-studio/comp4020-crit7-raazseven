---
import Layout from "../../layouts/Layout.astro";
import { avatarUrl, eventCoverUrl, nameOf } from "../../lib/avatar";
import { companionView } from "../../lib/companion";
import { getEvent, getEventTags, isInterested, listInterestedUsers } from "../../lib/db";
import { formatWhen, isStartingSoon } from "../../lib/time";

const idParam = Astro.params.id;
const id = idParam ? Number.parseInt(idParam, 10) : Number.NaN;
const event = Number.isInteger(id) ? getEvent(id) : undefined;

if (!event) {
  Astro.response.status = 404;
}

const user = Astro.locals.user;
const eventTags = event ? getEventTags(event.id) : [];
const going = event && user ? isInterested(user.id, event.id) : false;
const attendees = event ? listInterestedUsers(event.id) : [];
const candidateCount =
  event && user
    ? attendees.filter(
        (a) => a.id !== user.id && companionView(user, event.id, a.id).kind === "ask",
      ).length
    : 0;
---

<Layout title={event ? event.title : "Event not found"}>
  {
    event ? (
      <Fragment>
        <div class="card md:flex md:items-start md:gap-6">
          <img src={eventCoverUrl(event.id)} alt="" class="event-hero-cover" />
          <div class="mt-4 md:mt-0">
            <div class="flex items-start justify-between gap-2">
              <h1 class="!mt-0">{event.title}</h1>
              {isStartingSoon(event.startsAt) && <span class="badge">Starts soon</span>}
            </div>
            <p class="text-slate-600">
              {formatWhen(event.startsAt)} · {event.location}
            </p>
            <p class="mt-3">{event.description}</p>
            {eventTags.length > 0 && (
              <p class="mt-3 text-xs text-slate-500">
                {eventTags.map((tag) => tag.label).join(" · ")}
              </p>
            )}

            <div class="mt-4">
              {user ? (
                <form method="post" action={`/api/events/${event.id}/going`}>
                  <button type="submit" class={going ? "btn-secondary" : "btn-primary"}>
                    {going ? "I'm no longer going" : "I'm going"}
                  </button>
                </form>
              ) : (
                <a href="/login" class="btn-primary">
                  Log in to say you're going
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="mt-8 flex items-center justify-between gap-2">
          <h2 class="!mt-0">Who else is going</h2>
          {user && going && candidateCount > 0 && (
            <a href={`/events/${event.id}/discover`} class="btn-primary shrink-0">
              🔥 Find someone to go with
            </a>
          )}
        </div>
        {attendees.length === 0 ? (
          <p class="text-slate-500">Nobody yet — be the first.</p>
        ) : (
          <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {attendees.map((attendee) => {
              const isYou = user?.id === attendee.id;
              const view = isYou ? null : companionView(user, event.id, attendee.id);
              return (
                <li class="card flex items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <a href={`/u/${attendee.id}`}>
                      <img
                        src={avatarUrl(attendee.id)}
                        alt={`${nameOf(attendee.displayName)}'s avatar`}
                        class="avatar"
                      />
                    </a>
                    <a href={`/u/${attendee.id}`} class="font-medium text-slate-900 no-underline hover:underline">
                      {nameOf(attendee.displayName)}
                      {isYou && <span class="text-slate-500"> (you)</span>}
                    </a>
                  </div>
                  {view && view.kind === "ask" && (
                    <form method="post" action={`/api/events/${event.id}/ask`}>
                      <input type="hidden" name="toUserId" value={attendee.id} />
                      <button type="submit" class="btn-secondary shrink-0">
                        Ask
                      </button>
                    </form>
                  )}
                  {view && view.kind === "sent" && (
                    <span class="badge-muted shrink-0">Request sent</span>
                  )}
                  {view && view.kind === "reply" && (
                    <a href="/requests" class="badge shrink-0">
                      They asked you →
                    </a>
                  )}
                  {view && view.kind === "together" && (
                    <span class="badge-success shrink-0">Going together</span>
                  )}
                  {!user && !isYou && (
                    <a href="/login" class="text-sm text-slate-500 shrink-0">
                      Log in to ask
                    </a>
                  )}
                </li>
              );
            })}
          </ul>
        )}

        <p class="mt-6">
          <a href="/">← Back to the calendar</a>
        </p>
      </Fragment>
    ) : (
      <Fragment>
        <h1>Event not found</h1>
        <p>
          <a href="/">← Back to the calendar</a>
        </p>
      </Fragment>
    )
  }
</Layout>
