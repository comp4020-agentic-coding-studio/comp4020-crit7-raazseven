---
import Layout from "../../layouts/Layout.astro";
import { avatarUrl } from "../../lib/avatar";
import { getUserById } from "../../lib/db";

const id = Astro.params.id ?? "";
const profile = getUserById(id);

if (!profile) {
  Astro.response.status = 404;
}

const memberSince = profile
  ? new Date(profile.createdAt).toLocaleDateString("en-AU", { month: "long", year: "numeric" })
  : null;
const isYou = Astro.locals.user?.id === id;
---

<Layout title={profile ? (profile.displayName ?? "Attendee profile") : "Profile not found"}>
  {
    profile ? (
      <Fragment>
        <div class="card flex items-center gap-4">
          <img src={avatarUrl(profile.id)} alt={`${profile.displayName ?? "This attendee"}'s avatar`} class="avatar-lg" />
          <div>
            <h1 class="!mt-0">{profile.displayName ?? "No name set yet"}</h1>
            <p class="text-sm text-slate-500">Member since {memberSince}</p>
          </div>
        </div>
        {profile.bio && <p class="mt-4 whitespace-pre-line">{profile.bio}</p>}
        {isYou && (
          <p class="mt-4">
            <a href="/profile">This is you — edit your profile →</a>
          </p>
        )}
        <p class="mt-4">
          <a href="/">← Back to the calendar</a>
        </p>
      </Fragment>
    ) : (
      <Fragment>
        <h1>Profile not found</h1>
        <p>
          <a href="/">← Back to the calendar</a>
        </p>
      </Fragment>
    )
  }
</Layout>
